<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Zimension.Editor exactly as Unity builds it: a separate assembly that sees only the public API of
    Zimension.Core and Zimension.Runtime, compiled against UnityEditor/UnityEngine reference assemblies.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Zimension.Editor</AssemblyName>
    <NoWarn>CS0649;CS0169;CS0414</NoWarn>
    <WarningsAsErrors>CS0618;CS0619</WarningsAsErrors>
    <UnityRefs Condition="'$(UnityRefs)' == ''">$(MSBuildThisFileDirectory)../../.unity-refs/engine</UnityRefs>
    <UnityEditorRefs Condition="'$(UnityEditorRefs)' == ''">$(MSBuildThisFileDirectory)../../.unity-refs/editor</UnityEditorRefs>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/ZimensionUnity/Packages/com.zimension.runtime/Editor/**/*.cs" />
    <ProjectReference Include="Core.csproj" />
    <ProjectReference Include="Runtime.csproj" />
    <Reference Include="$(UnityRefs)/*.dll" Private="false" />
    <Reference Include="$(UnityEditorRefs)/*.dll" Private="false" />
  </ItemGroup>
</Project>
