{
  "world": {
    "_id": "fixture-world",
    "name": "Event Fixture",
    "showGround": true,
    "size": 60,
    "sunPosition": {
      "x": 0.35,
      "y": 0.25
    },
    "sunIntensity": 3,
    "sunColor": "#fff4e0",
    "spawnPosition": {
      "x": 0,
      "y": 0,
      "z": 8
    },
    "avatar": {
      "cameraType": "TPP",
      "cameraDistance": 3.5,
      "cameraHeight": 1.7,
      "walkSpeed": 1,
      "sprintSpeed": 1,
      "jumpHeight": 1,
      "rotation": {
        "x": 0,
        "y": 0,
        "z": 0
      }
    },
    "events": [
      "intro",
      "button_pressed",
      "open_door",
      "door_opened",
      "reward_show",
      "need_coin",
      "coin_collected"
    ],
    "variables": [
      {
        "name": "coins",
        "dataType": "number",
        "initialValue": 0
      },
      {
        "name": "score",
        "dataType": "number",
        "initialValue": 0
      }
    ],
    "eventBroadcasters": [
      {
        "name": "Intro",
        "startEvent": "on_start",
        "actionIndex": 0,
        "actionType": "Trigger Events",
        "triggerEvents": [
          "intro"
        ],
        "showMessage": "Grab the gold coin, then press F at the red button.",
        "link": ""
      },
      {
        "name": "Button",
        "startEvent": "button_pressed",
        "actionIndex": 0,
        "actionType": "Trigger Events",
        "triggerEvents": [
          "open_door"
        ],
        "delay": 1,
        "showMessage": "The door opens in one second...",
        "link": ""
      },
      {
        "name": "Check coin",
        "startEvent": "door_opened",
        "actionIndex": 2,
        "actionType": "Check Condition",
        "trueEvent": "reward_show",
        "falseEvent": "need_coin",
        "conditions": [
          {
            "targetVariable": {
              "name": "coins"
            },
            "logicOperator": ">=",
            "variableValueMode": "Value",
            "variableValue": "1"
          }
        ]
      },
      {
        "name": "Need coin",
        "startEvent": "need_coin",
        "actionIndex": 0,
        "actionType": "Trigger Events",
        "triggerEvents": [],
        "showMessage": "You need the coin first! Collect it and press the button again.",
        "link": ""
      },
      {
        "name": "Score",
        "startEvent": "coin_collected",
        "actionIndex": 1,
        "actionType": "Change Variable",
        "targetVariable": {
          "name": "score",
          "dataType": "number"
        },
        "values": [
          {
            "type": "Value",
            "value": "10"
          }
        ],
        "arthematicOperators": [
          "+"
        ]
      }
    ],
    "customHUDUI": {
      "elements": [
        {
          "id": "coins",
          "type": "text-box",
          "valueType": "variable",
          "variableName": "coins",
          "prefix": "Coins: ",
          "text": "Coins: 0",
          "style": {
            "left": "20px",
            "top": "20px",
            "fontSize": "20px",
            "backgroundColor": "rgba(0,0,0,0.55)",
            "color": "#ffffff"
          }
        },
        {
          "id": "score",
          "type": "text-box",
          "valueType": "variable",
          "variableName": "score",
          "prefix": "Score: ",
          "text": "Score: 0",
          "style": {
            "left": "20px",
            "top": "56px",
            "fontSize": "20px",
            "backgroundColor": "rgba(0,0,0,0.55)",
            "color": "#ffd34d"
          }
        }
      ]
    },
    "customUIOverRelays": [
      {
        "event": "reward_show",
        "hideEventName": "",
        "closeOnClick": true,
