<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-checks the Unity runtime assembly outside Unity against UnityEngine reference
    assemblies. Not used by Unity. UnityRefs must point at a folder of UnityEngine*.dll
    reference assemblies (see tools/compile-check/README.md).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0649;CS0169;CS0414</NoWarn>
    <AssemblyName>Zimension.Runtime.Check</AssemblyName>
    <UnityRefs Condition="'$(UnityRefs)' == ''">/tmp/claude-0/refs/m/lib/netstandard2.0</UnityRefs>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/ZimensionUnity/Packages/com.zimension.runtime/Runtime/**/*.cs" />
    <Reference Include="$(UnityRefs)/*.dll" Private="false" />
  </ItemGroup>
</Project>
