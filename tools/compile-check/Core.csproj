<Project Sdk="Microsoft.NET.Sdk">
  <!-- Zimension.Core exactly as Unity builds it: its own assembly, no Unity references (noEngineReferences). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Zimension.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/ZimensionUnity/Packages/com.zimension.runtime/Runtime/Core/**/*.cs" />
  </ItemGroup>
</Project>
