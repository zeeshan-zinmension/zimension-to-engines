<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Zimension.Runtime exactly as Unity builds it: a separate assembly that sees only Zimension.Core's
    public API, compiled against UnityEngine reference assemblies. Obsolete-API warnings are errors.
    See tools/compile-check/README.md.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Zimension.Runtime</AssemblyName>
    <NoWarn>CS0649;CS0169;CS0414</NoWarn>
    <WarningsAsErrors>CS0618;CS0619</WarningsAsErrors>
    <UnityRefs Condition="'$(UnityRefs)' == ''">$(MSBuildThisFileDirectory)../../.unity-refs/engine</UnityRefs>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/ZimensionUnity/Packages/com.zimension.runtime/Runtime/Unity/**/*.cs" />
    <ProjectReference Include="Core.csproj" />
    <Reference Include="$(UnityRefs)/*.dll" Private="false" />
  </ItemGroup>
</Project>
